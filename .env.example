NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only listmonk integration. Use a dedicated API user/token in production.
LISTMONK_URL=http://127.0.0.1:9001
# Public address used inside unsubscribe and browser-view links in delivered email.
LISTMONK_PUBLIC_URL=https://mail.community.example.com
LISTMONK_API_USER=commune-api
LISTMONK_API_TOKEN=replace-with-a-strong-api-token
LISTMONK_DEMO_USER=demo
LISTMONK_DEMO_PASSWORD=Demo123!

# Website builder. NEXT_PUBLIC_APP_HOST is the hostname the application itself answers on;
# any other Host header is treated as a connected site domain or subdomain. It falls back
# to the host of NEXT_PUBLIC_SITE_URL when unset.
NEXT_PUBLIC_APP_HOST=localhost
# Skips the DNS TXT check when connecting a custom domain. Local development only.
WEBSITE_ALLOW_UNVERIFIED_DOMAINS=false
